template func foo<type T>(x: T) -> void;

template struct str<type T> {
    injected struct str;
};

template_instantiation struct str<int> {
    method ~str() -> void;
    method str() -> void;
    method str(str<int> &) -> void;
    method str(str<int> &&) -> void;
};

template_instantiation func foo<str<int>>(x: str<int>) -> void;
func bar() -> void;
